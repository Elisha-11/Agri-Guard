# Copy to .env and adjust. Never commit .env.
# At least 32 characters: it also signs the login tokens (JWT).
SECRET_KEY=change-me-local-dev-only-at-least-32-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave unset to use SQLite. For Docker PostgreSQL:
# DATABASE_URL=postgres://agriguard:agriguard@localhost:5432/agriguard

# SMS for sign-in codes. Leave unset locally: codes are printed in the runserver window.
# Staging/production use Africa's Talking (docs/backend/auth.md):
# SMS_BACKEND=apps.accounts.sms.AfricasTalkingSmsBackend
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# AFRICASTALKING_SANDBOX=True
